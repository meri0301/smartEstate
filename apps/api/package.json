{
  "name": "@smartestate/api",
  "version": "0.1.0",
  "private": true,
  "description": "SmartEstate backend — NestJS modular monolith on the Fastify adapter.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:status": "prisma migrate status",
    "erd": "tsx prisma/erd/generate-erd.ts",
    "osm:fetch": "node prisma/seed/scripts/fetch-osm.ts",
    "openapi:export": "nest build && node dist/openapi/export.js",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/jwt": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@smartestate/contracts": "workspace:*",
    "fastify": "5.12.1",
    "nestjs-pino": "5.1.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@prisma/internals": "7.10.0",
    "@smartestate/eslint-config": "workspace:*",
    "@smartestate/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "testcontainers": "12.1.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
