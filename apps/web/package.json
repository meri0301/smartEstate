{
  "name": "@smartestate/web",
  "version": "0.1.0",
  "private": true,
  "description": "SmartEstate frontend — React 19 + Vite, Feature-Sliced Design.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:generate": "openapi-typescript ../../docs/api/openapi.json -o src/shared/api/schema.d.ts --root-types --root-types-no-schema-prefix --default-non-nullable=false"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@smartestate/contracts": "workspace:*",
    "@smartestate/eslint-config": "workspace:*",
    "@smartestate/tsconfig": "workspace:*",
    "@tanstack/react-query-devtools": "5.102.8",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
