{
  "name": "@smartestate/web",
  "version": "0.1.0",
  "private": true,
  "description": "SmartEstate frontend — React 19 + Vite, Feature-Sliced Design.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:generate": "openapi-typescript ../../docs/api/openapi.json -o src/shared/api/schema.d.ts --root-types --root-types-no-schema-prefix --default-non-nullable=false",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "i18n:check": "tsx scripts/check-i18n.ts"
  },
  "dependencies": {
    "@fontsource/krona-one": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/noto-sans-armenian": "5.3.0",
    "@smartestate/ui-tokens": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.4.2",
    "i18next-icu": "2.4.4",
    "intl-messageformat": "11.2.15",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.14",
    "react-router": "8.3.1",
