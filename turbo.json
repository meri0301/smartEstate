{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".env", "packages/tsconfig/*.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"]
    },
    "lint": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build", "db:generate"]
    },
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"],
      "env": ["DATABASE_URL"]
    },
    "openapi:export": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "env": [
        "DATABASE_URL",
        "NODE_ENV",
        "API_PORT",
        "JWT_*",
        "REFRESH_TOKEN_*",
        "COOKIE_SECURE",
        "CORS_ORIGINS",
        "LOG_LEVEL",
        "RATE_LIMIT_*",
        "SWAGGER_ENABLED"
      ]
    },
    "embeddings:backfill": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "env": ["DATABASE_URL", "NODE_ENV", "LOG_LEVEL", "ML_*", "JWT_*", "REDIS_URL"]
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "tokens:css": {
      "inputs": ["src/tokens.ts", "src/render-css.ts"],
      "outputs": ["styles/tokens.css"]
    },
    "i18n:check": {
      "dependsOn": ["^build"],
      "inputs": ["src/locales/**", "src/shared/i18n/**", "scripts/check-i18n.ts"],
      "outputs": []
    }
  }
}
