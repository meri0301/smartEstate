# SmartEstate — local environment
# Copy to `.env` (git-ignored). Docker Compose reads `.env` from the repo root
# for variable interpolation; the apps read it at start-up.
#
# Only variables consumed by the current phase are listed. Each later phase adds
# its own block (LLM provider selection, embedding model, ML service URL, ...).

# --- PostgreSQL 16 + PostGIS + pgvector -------------------------------------
POSTGRES_USER=smartestate
POSTGRES_PASSWORD=smartestate
POSTGRES_DB=smartestate
POSTGRES_PORT=5432
DATABASE_URL=postgresql://smartestate:smartestate@localhost:5432/smartestate?schema=public

# --- Redis 7 ------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Service ports -------------------------------------------------------------
API_PORT=3000
WEB_PORT=5173
# Where the Vite dev server proxies /api, when the API is not on localhost:3000.
# API_PROXY_TARGET=http://localhost:3100
ML_PORT=8000
# Where the API reaches the ML service, and how long it waits for a valuation.
ML_BASE_URL=http://localhost:8000
ML_TIMEOUT_MS=2000

# --- Language model -----------------------------------------------------------
# rule-based performs no network call and is the default: the whole product works
# with no keys at all. gemini and ollama are enhancements.
LLM_PROVIDER=rule-based
LLM_ENABLED=true
# Google AI Studio, free tier. NEVER enable billing on that Google project: the
# allowances below are treated as hard limits and exceeding them degrades the
# feature rather than costing money.
GEMINI_API_KEY=
# Left unset, the model follows the provider: a Flash model for Gemini, llama3.2
# for Ollama.
# LLM_MODEL=
LLM_TIMEOUT_MS=8000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_MS=30000
LLM_REQUESTS_PER_MINUTE=10
LLM_REQUESTS_PER_DAY=250
LLM_CACHE_TTL_SECONDS=86400

# --- API runtime -------------------------------------------------------------
NODE_ENV=development
# 32+ random characters; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-secret-change-me-0123456789abcdefghijklmnop
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Refresh cookie `Secure` flag; defaults to true in production, false otherwise
# COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Requests per minute per IP on ordinary routes (credential routes are fixed at 10/min)
RATE_LIMIT_MAX=300
SWAGGER_ENABLED=true

# --- Web -----------------------------------------------------------------------
# API origin for the browser client; empty = same origin (Vite proxy in dev, single-origin in Docker)
VITE_API_BASE_URL=

# Personal income tax rate (%), for the mortgage refund calculator.
# No default on purpose: confirm the current rate with the State Revenue
# Committee before setting it. Left unset, the calculator asks for the tax paid
# rather than deriving it from a salary.
# MORTGAGE_INCOME_TAX_RATE_PCT=
