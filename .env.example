# SmartEstate — local environment
# Copy to `.env` (git-ignored). Docker Compose reads `.env` from the repo root
# for variable interpolation; the apps read it at start-up.
#
# Only variables consumed by the current phase are listed. Each later phase adds
# its own block (LLM provider selection, embedding model, ML service URL, ...).

# --- PostgreSQL 16 + PostGIS + pgvector -------------------------------------
POSTGRES_USER=smartestate
POSTGRES_PASSWORD=smartestate
POSTGRES_DB=smartestate
POSTGRES_PORT=5432
DATABASE_URL=postgresql://smartestate:smartestate@localhost:5432/smartestate?schema=public

# --- Redis 7 ------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Service ports -------------------------------------------------------------
API_PORT=3000
WEB_PORT=5173
ML_PORT=8000

# --- API runtime -------------------------------------------------------------
NODE_ENV=development
# 32+ random characters; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-secret-change-me-0123456789abcdefghijklmnop
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Refresh cookie `Secure` flag; defaults to true in production, false otherwise
# COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Requests per minute per IP on ordinary routes (credential routes are fixed at 10/min)
RATE_LIMIT_MAX=300
SWAGGER_ENABLED=true

# --- Web -----------------------------------------------------------------------
# API origin for the browser client; empty = same origin (Vite proxy in dev, single-origin in Docker)
VITE_API_BASE_URL=
