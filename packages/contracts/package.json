{
  "name": "@smartestate/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Single source of truth for API contracts: Zod schemas and the TypeScript types derived from them, shared by apps/api and apps/web.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@smartestate/eslint-config": "workspace:*",
    "@smartestate/tsconfig": "workspace:*",
    "@types/node": "24.13.4",
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "zod": "4.6.2"
  }
}
